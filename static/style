body { background-color: #12141d; color: #f4f4f4; font-family: 'Segoe UI', sans-serif; padding: 30px; max-width: 800px; margin: auto; }
h1 { color: #00c37a; }
textarea, select, button { width: 100%; padding: 12px; border-radius: 8px; border: none; margin-top: 10px; font-size: 16px; }
button { background-color: #00c37a; color: white; font-weight: bold; cursor: pointer; }
#responseBox { background-color: #2c2f45; padding: 20px; border-radius: 10px; margin-top: 15px; white-space: pre-wrap; font-size: 16px; }
footer { margin-top: 40px; text-align: center; font-size: 14px; color: #888; }
